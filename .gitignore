# Registros de construccion
*.log

# Archivos ISO e imagenes de disco
*.iso
*.img
*.hybrid.iso

# Archivos temporales de live-build
live-build/**/.build/
live-build/**/binary/
live-build/**/chroot/
live-build/**/cache/
live-build/**/local/
live-build/**/auto/
live-build/**/binary.*
live-build/**/chroot.*
live-build/**/live-image-*
live-build/**/lb_*

# Salidas generadas
output/*
!output/.gitkeep

# Archivos temporales del sistema
*~
*.swp
.DS_Store
Thumbs.db

# Hooks predeterminados generados por live-build
live-build/**/config/hooks/live/
live-build/**/config/hooks/normal/
